rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The whole app lives in one document. Only the listed Google accounts may read or write it.
    // This file is the template: the live rules (Firebase console → Firestore → Rules) have the real emails,
    // which stay out of this public repo. Keep the two in the same shape.
    // The caregivers: only these Google accounts.
    function caregiver() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['FIRST_PERSON@gmail.com', 'SECOND_PERSON@gmail.com'];
    }
    match /state/main {
      allow read: if caregiver();
      // Saves must carry the current data version (SCHEMA in index.html). A phone still running an older
      // build of the app is refused here instead of saving its out-of-date copy over everyone's data.
      allow write: if caregiver() && request.resource.data.v == 2;
    }
    // Shared camera card (experimental, 26.11): ONE cropped crate image, overwritten in place (no history), plus a small
    // heartbeat. Every caregiver may read; only the camera's own Firebase account may write, only these two documents,
    // only in this shape; it can never touch state/main. <CAMERA_UID> and the emails live only in the live rules.
    match /camera/{d} {
      allow read: if caregiver() && d in ['latest', 'status', 'events', 'events_preview', 'feedback'];
      allow read: if d == 'feedback' && request.auth != null && request.auth.uid == '<CAMERA_UID>';   // the camera reads her decisions
      allow create, update: if d == 'feedback' && caregiver() && request.resource.data.keys().hasOnly(['decisions']) && request.resource.data.decisions is map;
      allow create, update: if request.auth != null && request.auth.uid == '<CAMERA_UID>'
        && request.resource.data.published_at is int
        && request.resource.data.published_at > request.time.toMillis() - 300000
        && request.resource.data.published_at < request.time.toMillis() + 300000
        && ((d == 'latest'
              && request.resource.data.keys().hasOnly(['image','image_type','bytes','capture_ts','published_at','detection','model_version','validated','experimental','sha256_16','note','view','w','h'])
              && request.resource.data.image is bytes && request.resource.data.image.size() <= 61440
              && request.resource.data.image_type == 'image/jpeg'
              && request.resource.data.capture_ts is int
              && request.resource.data.detection.status == 'positive'
              && (!('view' in request.resource.data) || request.resource.data.view in ['full', 'crop'])
              && (!('w' in request.resource.data) || (request.resource.data.w is int && request.resource.data.w <= 1920))
              && (!('h' in request.resource.data) || (request.resource.data.h is int && request.resource.data.h <= 1080)))
          || ((d == 'events' || d == 'events_preview')
              && request.resource.data.keys().hasOnly(['schema','events','coverage','door_spans','updated_at','published_at','model_version'])
              && request.resource.data.events is list && request.resource.data.events.size() <= 400)
          || (d == 'status'
              && request.resource.data.keys().hasOnly(['checked_at','service','model_version','experimental','crate_now','budget','published_at'])
              && request.resource.data.checked_at is int));
      // camera/gravel_live_preview (trial) and camera/gravel_live (production, §18c): the Cam 3 gravel visit as it happens.
      // Only the camera publisher writes, only these two documents, only this shape (≤ 3 visits — the rules' expression
      // budget allows three checked field by field); caregivers read. It never touches state/main. Added 27.11 (release 7), additive: nothing above changes.
      // One visit, field by field (a missing field is an error = denied; opened_at / closed_at / camera / model_version optional).
      function gravelVisitOk(v, now) {
        return v.keys().hasOnly(['visit_id','kind','status','t_start','last_seen','t_end','opened_at','closed_at','dog','identity_confidence','ir','uncertain','camera','model_version'])
          && v.visit_id is string && v.visit_id.size() > 0 && v.visit_id.size() <= 40
          && v.kind == 'gravel_live'
          && v.t_start is int && v.t_start > now - 86400000 && v.t_start < now + 60000
          && v.last_seen is int && v.last_seen >= v.t_start && v.last_seen < now + 60000
          && (v.status == 'open' ? v.t_end == null : (v.status == 'closed' && v.t_end is int && v.t_end >= v.t_start && v.t_end < now + 60000))
          && v.dog in [null, 'kishmish', 'kochik']
          && v.identity_confidence in ['ask', 'reliable']
          && v.ir is bool && v.uncertain is bool
          && (v.get('opened_at', null) == null || v.opened_at is int) && (v.get('closed_at', null) == null || v.closed_at is int)
          && v.get('camera', 'cam3') == 'cam3' && v.get('model_version', '') is string;
      }
      allow read: if (d == 'gravel_live' || d == 'gravel_live_preview') && caregiver();
      allow create, update: if (d == 'gravel_live' || d == 'gravel_live_preview') && request.auth != null && request.auth.uid == '<CAMERA_UID>'
        && request.resource.data.keys().hasAll(['schema','camera','published_at','visits'])
        && request.resource.data.keys().hasOnly(['schema','camera','published_at','model_version','coverage','visits'])
        && request.resource.data.schema == 'cam-gravel-live/1'
        && request.resource.data.camera == 'cam3'
        && request.resource.data.published_at is int
        && request.resource.data.published_at > request.time.toMillis() - 300000
        && request.resource.data.published_at < request.time.toMillis() + 300000
        && (!('model_version' in request.resource.data) || (request.resource.data.model_version is string && request.resource.data.model_version.size() <= 64))
        && (!('coverage' in request.resource.data) || (request.resource.data.coverage is map
              && request.resource.data.coverage.keys().hasOnly(['recorder_ok','status_age_s','live_file_age_s','reason'])
              && request.resource.data.coverage.recorder_ok is bool
              && (request.resource.data.coverage.get('status_age_s', null) == null || request.resource.data.coverage.status_age_s is int)
              && (request.resource.data.coverage.get('live_file_age_s', null) == null || request.resource.data.coverage.live_file_age_s is int)
              && (request.resource.data.coverage.get('reason', null) == null || (request.resource.data.coverage.reason is string && request.resource.data.coverage.reason.size() <= 80))))
        && request.resource.data.visits is list && request.resource.data.visits.size() <= 3
        && (request.resource.data.visits.size() < 1 || gravelVisitOk(request.resource.data.visits[0], request.time.toMillis()))
        && (request.resource.data.visits.size() < 2 || gravelVisitOk(request.resource.data.visits[1], request.time.toMillis()))
        && (request.resource.data.visits.size() < 3 || gravelVisitOk(request.resource.data.visits[2], request.time.toMillis()));
      allow delete: if false;
    }
  }
}
